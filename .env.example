# ── LangSmith ─────────────────────────────────────────────────────────────────
# Enable LangSmith tracing (required for evaluate() in compare.ts)
LANGCHAIN_TRACING_V2=true

# LangSmith API key — get yours at https://smith.langchain.com/settings
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LangSmith project name — runs and experiments will appear here
LANGCHAIN_PROJECT=llm-perf-benchmark

# LangSmith API endpoint (optional — defaults to https://api.smith.langchain.com)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Base URL of your local Ollama instance (optional — defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
